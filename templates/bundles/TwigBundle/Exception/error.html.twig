{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code }}{% endblock %}

{% block body %}
    <h1>{{ status_code }}</h1>
    <p>{{ status_code == 404 ? 'Page introuvable.' : (status_code == 503 ? 'Service momentanément indisponible, réessayez plus tard.' : 'Une erreur est survenue.') }}</p>
    <p><a href="{{ path('product_list') }}">Retour à l'accueil</a></p>
{% endblock %}
